---
import PageV2 from '../layouts/PageV2.astro';
import { caseStudiesFor } from '../lib/writing';
import type { Lang } from './nav/navMachine';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEnglish = lang === 'en';
const studies = caseStudiesFor(lang);

const t = isEnglish
  ? {
      title: 'Case studies — Diel Duarte',
      description: "Deep dives into technical challenges I've tackled: architecture decisions, performance wins, and lessons learned.",
      heading: 'Case studies',
      lede: "Deep dives into technical challenges I've tackled: architecture decisions, performance wins, and lessons learned.",
      langSwitchHref: '/case-studies/pt-br/',
    }
  : {
      title: 'Estudos de caso — Diel Duarte',
      description: 'Mergulhos em desafios técnicos que enfrentei: decisões de arquitetura, ganhos de performance e lições aprendidas.',
      heading: 'Estudos de caso',
      lede: 'Mergulhos em desafios técnicos que enfrentei: decisões de arquitetura, ganhos de performance e lições aprendidas.',
      langSwitchHref: '/case-studies/en/',
    };
---

<PageV2 lang={lang} title={t.title} description={t.description} currentState="cases" langSwitchHref={t.langSwitchHref}>
  <section class="frame">
    <div class="grid">
      <h1 class="section-title">{t.heading}</h1>
      <p class="lede reading">{t.lede}</p>
      <ul class="list">
        {studies.map((s) => (
          <li>
            <a href={s.href}>
              <span class="company">{s.company}</span>
              <span class="name">{s.title}</span>
              <span class="impact">{s.impact}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageV2>

<style>
  .lede {
    grid-column: 1 / 6;
    margin: 0;
    padding: var(--cell-pad) var(--cell-pad) 32px;
  }

  .list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li { display: contents; }

  .list a {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
  }

  @media (hover: hover) and (pointer: fine) {
    .list a:hover { background: var(--cobalt); color: var(--paper); }
  }

  .list a > span { padding: 0 var(--cell-pad); }
  .company { grid-column: 1 / 3; }
  .name { grid-column: 3 / 9; font-size: var(--fs-row); font-weight: 500; }
  .impact { grid-column: 9 / 13; }

  @media (max-width: 760px) {
    .lede { grid-column: 1 / -1; }
    .company { grid-column: 1 / -1; color: var(--muted); }
    .name, .impact { grid-column: 1 / -1; padding-top: 4px; }
  }
</style>
