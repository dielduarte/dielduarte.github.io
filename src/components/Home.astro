---
import PageV2 from '../layouts/PageV2.astro';
import { ogImagePath } from '../lib/og-pages.mjs';
import Spread from './grid/Spread.astro';
import PostRow from './grid/PostRow.astro';
import { postsFor } from '../lib/writing';
import type { Lang } from './nav/navMachine';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    title: 'Diel Duarte — Software engineer at Resend',
    description:
      'Diel Duarte works on devtools at Resend. Writes about statecharts, XState, code splitting, and frontend architecture.',
    langSwitchHref: '/pt-br/',
    kicker: 'Software engineer, devtools at Resend',
    sentence: 'I build web software',
    cells: [[1, 3, 4], [1, 6, 10], [2, 1, 5], [3, 4, 10]],
    highlight: 2,
    intro:
      'Mostly JavaScript, mostly frontend. I care about architecture, developer experience, and helping teams ship fast without trading away quality.',
    latest: 'Latest writing',
    all: 'All writing',
  },
  'pt-br': {
    title: 'Diel Duarte — Engenheiro de software na Resend',
    description:
      'Diel Duarte trabalha com devtools na Resend e escreve sobre statecharts, XState, code splitting e arquitetura de front-end.',
    langSwitchHref: '/',
    kicker: 'Engenheiro de software, devtools na Resend',
    sentence: 'Eu construo software para a web',
    cells: [[1, 3, 5], [1, 6, 11], [2, 1, 6], [2, 7, 10], [3, 2, 3], [3, 4, 8]],
    highlight: 5,
    intro:
      'Quase sempre JavaScript, quase sempre frontend. Gosto de cuidar da arquitetura e da experiência de desenvolvimento, e de ajudar times a entregar rápido sem abrir mão da qualidade.',
    latest: 'Últimos textos',
    all: 'Todos os textos',
  },
} satisfies Record<Lang, { cells: Array<[number, number, number]> } & Record<string, unknown>>;

const t = content[lang];
const latest = postsFor(lang).slice(0, 3);
---

<PageV2
  lang={lang}
  title={t.title}
  description={t.description}
  currentState="home"
  image={ogImagePath('home', lang)}
  langSwitchHref={t.langSwitchHref}
>
  <Spread
    lang={lang}
    size="xl"
    kicker={t.kicker}
    sentence={t.sentence}
    cells={t.cells}
    highlight={t.highlight}
    portrait={{ rows: [2, 4], cols: [10, 13], variant: 'block' }}
  />

  <section class="frame">
    <div class="grid intro">
      <p class="lead reading">{t.intro}</p>
      <h2 class="sr-only">{t.latest}</h2>
      <div class="latest">
        {latest.map((post) => <PostRow post={post} variant="compact" />)}
      </div>
      <div class="all">
        <a class="link" href={lang === 'en' ? '/blog/en/' : '/blog/pt-br/'}>{t.all}</a>
      </div>
    </div>
  </section>
</PageV2>

<style>
  .intro {
    align-items: start;
  }

  .lead {
    grid-column: 1 / 4;
    margin: 0;
    padding: 12px var(--cell-pad) 32px;
  }

  .latest {
    grid-column: 5 / 10;
    display: grid;
    grid-template-columns: subgrid;
  }

  .latest :global(.row:first-child) {
    border-top: 0;
  }

  .all {
    grid-column: 10 / 13;
    padding: 12px var(--cell-pad);
    font-size: var(--fs-small);
  }

  @media (max-width: 760px) {
    .lead,
    .latest,
    .all { grid-column: 1 / -1; }

    .latest :global(.row:first-child) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
