---
/**
 * Shared shell for long-form pages (blog posts and case studies): headline,
 * a facts table, and serif prose on the grid.
 */
interface Props {
  title: string;
  dek?: string;
  facts: Array<[string, string]>;
  backHref: string;
  backLabel: string;
}

const { title, dek, facts, backHref, backLabel } = Astro.props;
---

<div class="reading-progress" data-progress aria-hidden="true"></div>

<article class="frame">
  <header class="grid head">
    <div class="back"><a class="link" href={backHref}>{backLabel}</a></div>
    <h1 class="title">{title}</h1>
    {dek && <p class="dek">{dek}</p>}
    <dl class="facts">
      {facts.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </header>

  <div class="grid body">
    <div class="prose">
      <slot />
    </div>
  </div>
</article>

<script>
  let stop: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    stop?.();
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const article = document.querySelector<HTMLElement>('article');
    if (!bar || !article) return;

    const update = () => {
      const end = article.offsetTop + article.offsetHeight - window.innerHeight;
      const progress = Math.min(Math.max(window.scrollY / Math.max(end, 1), 0), 1);
      bar.style.transform = `scaleX(${progress})`;
    };

    window.addEventListener('scroll', update, { passive: true });
    stop = () => window.removeEventListener('scroll', update);
    update();
  });
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--cobalt);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 100;
  }

  .head {
    align-items: start;
  }

  .back {
    grid-column: 1 / 3;
    padding: var(--cell-pad);
    font-size: var(--fs-small);
  }

  .title {
    grid-column: 3 / 12;
    margin: 0;
    padding: 24px var(--cell-pad) 0;
    font-size: var(--fs-display-md);
    font-weight: 700;
    font-stretch: 75%;
    letter-spacing: -0.01em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .dek {
    grid-column: 3 / 10;
    margin: 0;
    padding: 20px var(--cell-pad) 0;
    font-family: var(--font-reading);
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: var(--muted);
  }

  .facts {
    grid-column: 3 / 13;
    display: grid;
    grid-template-columns: subgrid;
    margin: 32px 0 0;
  }

  .facts div {
    grid-column: span 2;
    padding: 8px var(--cell-pad) 12px;
    border-top: 1px solid var(--rule);
  }

  .facts dt { color: var(--muted); }
  .facts dd { margin: 2px 0 0; font-size: var(--fs-small); font-weight: 500; }

  .body {
    border-top: 0;
    padding: 48px 0 24px;
  }

  /* Solid paper so the column hairlines stop at the text instead of striking through it. */
  .prose {
    grid-column: 3 / 10;
    padding: 0 var(--cell-pad);
    background: var(--paper);
    font-family: var(--font-reading);
    font-size: 1.25rem;
    line-height: 1.65;
    color: #111;
    max-width: 72ch;
  }

  .prose :global(p) { margin: 0 0 1.4em; }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-grotesk);
    font-weight: 700;
    font-stretch: 75%;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 2em 0 0.6em;
  }

  .prose :global(h2) { font-size: 1.9rem; }
  .prose :global(h3) { font-size: 1.4rem; }
  .prose :global(h4) { font-size: 1.15rem; }

  .prose :global(a) {
    color: var(--cobalt);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) { background: var(--sun); color: var(--ink); }

  .prose :global(strong) { font-weight: 700; }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .prose :global(:not(pre) > code) {
    background: rgba(0, 0, 0, 0.07);
    padding: 0.1em 0.35em;
  }

  .prose :global(pre) {
    margin: 2em 0;
    padding: 20px;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.2em 0;
    padding-left: 1.4em;
  }

  .prose :global(ul) { list-style: square; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(li::marker) { color: var(--cobalt); }

  .prose :global(blockquote) {
    margin: 2em 0;
    padding: 4px 0 4px 20px;
    border-left: 4px solid var(--sun);
    font-style: italic;
  }

  .prose :global(blockquote p) { margin: 0; }

  .prose :global(img),
  .prose :global(video) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em 0;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 3em 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-grotesk);
    font-size: var(--fs-small);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 10px 8px 0;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 760px) {
    .back,
    .title,
    .dek,
    .facts,
    .prose { grid-column: 1 / -1; }

    .title { padding-top: 8px; }
    .facts div { grid-column: span 2; }
    .body { padding-top: 28px; }
    .prose { font-size: 1.125rem; }
  }
</style>
