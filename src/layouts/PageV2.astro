---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/literata/standard.css';
import '@fontsource-variable/literata/standard-italic.css';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import { ViewTransitions } from 'astro:transitions';
import StateBar from '../components/grid/StateBar.astro';
import type { Lang, NavStateId } from '../components/nav/navMachine';
import { ogImagePath } from '../lib/og-pages.mjs';
import { alternateLinks } from '../lib/alternates';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  currentState: NavStateId;
  langSwitchHref: string;
  /** Share image, site-relative (images/og/home-en.png) or root-relative (/_astro/…). Defaults to the home card. */
  image?: string;
  type?: 'website' | 'article';
}

const { lang, title, description, currentState, langSwitchHref, image, type = 'website' } = Astro.props;
const isEnglish = lang === 'en';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image ?? ogImagePath('home', lang), Astro.site).href;
const alternates = alternateLinks({ lang, pathname: Astro.url.pathname, langSwitchHref, site: Astro.site! });
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Diel Duarte" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'pt_BR'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@diel_duarte" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <ViewTransitions />

    <style is:global>
      :root { color-scheme: light; }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-grotesk);
        line-height: 1.35;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Small text is the default on the page, but rem stays at the browser's 16px so
         long-form sizes set in rem read at their intended size.
         The body is at least one screen tall with main stretching, so the footer always
         sits at the bottom and the grid runs unbroken down to it. */
      body {
        position: relative;
        z-index: 0;
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        font-size: var(--fs-meta);
      }

      main { flex: 1; }

      /* The visible grid: one set of column hairlines behind the whole page, top to bottom,
         aligned with the content edges of every .frame. */
      body::before {
        --edge: max(var(--gutter), calc((100% - var(--frame-max)) / 2 + var(--gutter)));
        content: '';
        position: absolute;
        z-index: -1;
        inset: 0 var(--edge);
        border-right: 1px solid var(--rule);
        background: repeating-linear-gradient(
          to right,
          var(--rule) 0 1px,
          transparent 1px calc(100% / var(--cols))
        );
        pointer-events: none;
      }

      a { color: inherit; text-decoration: none; }

      :focus-visible {
        outline: 2px solid var(--cobalt);
        outline-offset: -2px;
      }

      .frame {
        position: relative;
        width: 100%;
        max-width: var(--frame-max);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }

      .grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        border-top: 1px solid var(--rule);
      }

      .cell { padding: var(--cell-pad); }

      .link {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      @media (hover: hover) and (pointer: fine) {
        .link:hover {
          background: var(--ink);
          color: var(--paper);
          text-decoration: none;
        }
      }

      /* Paragraphs meant to be read: serif, and solid paper so the hairlines stop at the text. */
      .reading {
        font-family: var(--font-reading);
        font-size: var(--fs-reading);
        line-height: 1.6;
        background: var(--paper);
      }



      .section-title {
        grid-column: 1 / 7;
        margin: 0;
        padding: 40px var(--cell-pad) 10px;
        font-size: var(--fs-display-md);
        font-weight: 700;
        font-stretch: 75%;
        letter-spacing: -0.01em;
        line-height: 0.9;
      }

      .copy {
        grid-column: 1 / -1;
        margin: 0;
        padding-block: 24px 32px;
      }

      .section-meta {
        grid-column: 10 / 13;
        align-self: end;
        margin: 0;
        padding: var(--cell-pad);
        text-align: right;
      }

      .skip-link {
        position: absolute;
        top: 8px;
        left: 8px;
        padding: 8px 12px;
        background: var(--sun);
        color: var(--ink);
        transform: translateY(-200%);
        z-index: 1000;
      }
      .skip-link:focus { transform: translateY(0); }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 760px) {
        .section-title { grid-column: 1 / -1; padding-top: 28px; }
        .section-meta { grid-column: 1 / -1; text-align: left; padding-top: 0; }
      }

      /* ── State transitions ───────────────────────────────────────
         Named cells (words, marker, highlight, portrait, rows) travel
         to their new place. Everything unnamed is the root snapshot:
         the new page wipes in over the old one, left to right. */

      ::view-transition-group(*) {
        animation-duration: var(--vt-duration);
        animation-timing-function: var(--vt-ease);
      }

      /* Old and new pages share one moving cut line, so the two never print on top of
         each other: the old page is trimmed from the left exactly as the new one is revealed. */
      html::view-transition-old(root) {
        animation: vt-wipe-out 380ms var(--vt-ease) 60ms both !important;
        mix-blend-mode: normal;
      }

      html::view-transition-new(root) {
        animation: vt-wipe-in 380ms var(--vt-ease) 60ms both !important;
        mix-blend-mode: normal;
      }

      ::view-transition-old(*):only-child {
        animation: vt-wipe-out 200ms var(--vt-ease) both;
      }

      ::view-transition-new(*):only-child {
        animation: vt-wipe-in 320ms var(--vt-ease) 200ms both;
      }

      /* Rows change width between layouts; crop the snapshot instead of stretching the
         text, and hand over quickly so the two layouts never print on top of each other. */
      ::view-transition-old(*.row),
      ::view-transition-new(*.row) {
        width: 100%;
        height: 100%;
        object-fit: none;
        object-position: left top;
      }

      ::view-transition-old(*.row) {
        animation: vt-fade-out 120ms linear both;
      }

      ::view-transition-new(*.row) {
        animation: vt-wipe-in 340ms var(--vt-ease) 80ms both;
      }

      /* Both portrait snapshots keep their natural size, centred, and the frame clips them
         as it resizes: the animation starts from exactly what was on screen and the face
         never scales. They line up pixel for pixel, so the new one simply sits on top. */
      ::view-transition-image-pair(portrait) {
        overflow: hidden;
      }

      ::view-transition-old(portrait),
      ::view-transition-new(portrait) {
        inset: 50% auto auto 50%;
        width: auto;
        height: auto;
        translate: -50% -50%;
        animation: none;
        mix-blend-mode: normal;
      }

      @keyframes vt-fade-out {
        to { opacity: 0; }
      }

      @keyframes vt-wipe-in {
        from { clip-path: inset(0 100% 0 0); }
        to { clip-path: inset(0 0 0 0); }
      }

      @keyframes vt-wipe-out {
        from { clip-path: inset(0 0 0 0); }
        to { clip-path: inset(0 0 0 100%); }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {isEnglish ? 'Skip to content' : 'Pular para o conteúdo'}
    </a>

    <StateBar lang={lang} current={currentState} langSwitchHref={langSwitchHref} />

    <main id="main">
      <slot />
    </main>

    <footer class="frame">
      <div class="grid">
        <p class="cell copy">© {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>
