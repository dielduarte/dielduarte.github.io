---
import PageV2 from './PageV2.astro';
import Article from '../components/grid/Article.astro';
import readingTime from 'reading-time';
import { SEO } from 'astro-seo';
import fs from 'fs';

const { frontmatter, file } = Astro.props;

const stats = readingTime(fs.readFileSync(file, 'utf8'));
const isEnglish = frontmatter.languageKey === 'en';
const lang = isEnglish ? 'en' : 'pt-br';

const socialImage = Astro.site + frontmatter.socialImage;
// Frontmatter dates are calendar days; format in UTC so Brazil's offset can't shift the day.
const formattedDate = new Date(frontmatter.date).toLocaleDateString(isEnglish ? 'en-US' : 'pt-BR', {
  timeZone: 'UTC',
  dateStyle: 'long',
});

const indexHref = isEnglish ? '/blog/en/' : '/blog/pt-br/';

function normalizeLangLink(raw?: string) {
  if (!raw) return null;
  const withLeading = raw.startsWith('/') ? raw : `/${raw}`;
  const prefixed = withLeading.startsWith('/blog') ? withLeading : `/blog${withLeading}`;
  return prefixed.endsWith('/') ? prefixed : `${prefixed}/`;
}

const langSwitchHref = normalizeLangLink(frontmatter.languageLink) ?? (isEnglish ? '/blog/pt-br/' : '/blog/en/');

const facts: Array<[string, string]> = [
  [isEnglish ? 'Published' : 'Publicado', formattedDate],
  [isEnglish ? 'Reading time' : 'Tempo de leitura', isEnglish ? stats.text : `${Math.ceil(stats.minutes)} min`],
  [isEnglish ? 'Language' : 'Idioma', isEnglish ? 'English' : 'Português'],
];
---

<PageV2
  lang={lang}
  title={frontmatter.title}
  currentState="writing"
  langSwitchHref={langSwitchHref}
>
  <SEO
    slot="head"
    description={frontmatter.description}
    openGraph={{
      basic: {
        title: frontmatter.title,
        type: 'article',
        image: socialImage ?? '',
      },
    }}
    extend={{
      meta: [
        { name: 'twitter:image', content: socialImage },
        { name: 'twitter:title', content: frontmatter.title },
        { name: 'twitter:site', content: '@diel_duarte' },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:description', content: frontmatter.description },
      ],
    }}
  />

  <Article
    title={frontmatter.title}
    dek={frontmatter.description}
    facts={facts}
    backHref={indexHref}
    backLabel={isEnglish ? 'All writing' : 'Todos os textos'}
  >
    <slot />
  </Article>
</PageV2>
