---
import PageV2 from '../../layouts/PageV2.astro';
import { ogImagePath } from '../../lib/og-pages.mjs';
import { Image } from 'astro:assets';
import Spread from '../../components/grid/Spread.astro';
import { photoHref, photosIndexHref, photosNewestFirst } from '../../lib/photos';
import type { Lang } from '../../components/nav/navMachine';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt-br' } }];
}

const { lang } = Astro.params as { lang: Lang };

const content = {
  en: {
    title: 'About — Diel Duarte',
    description: 'Diel Duarte works on devtools at Resend. Writes about statecharts, XState, and frontend architecture.',
    langSwitchHref: '/about/pt-br/',
    sentence: 'I live in Belo Horizonte.',
    country: 'Brazil',
    cells: [[1, 1, 2], [1, 2, 5], [1, 5, 6], [2, 1, 3], [2, 3, 9]],
    paragraphs: [
      "I'm Diel Duarte, a software engineer who works mostly in the browser. I spend my days shaping architecture and developer experience.",
      "Over the years I've moved from generalist full-stack work into frontend. I care about the architecture of legible UI: splitting code along the grain of a product, modelling interactions as explicit state, and making the invisible parts of a system readable to the next person. I've led teams, worked at companies of every size, and I'm comfortable across the whole stack, infrastructure included.",
    ],
    projectsHeading: 'Side projects',
    photosHeading: 'Photos',
    allPhotos: 'All photos',
    experienceHeading: 'Career highlights',
    present: 'present',
    more: 'More on LinkedIn',
    newTab: '(opens in new tab)',
  },
  'pt-br': {
    title: 'Sobre — Diel Duarte',
    description: 'Diel Duarte trabalha com devtools na Resend e escreve sobre statecharts, XState e arquitetura de front-end.',
    langSwitchHref: '/about/en/',
    sentence: 'Eu moro em Belo Horizonte.',
    country: 'Brasil',
    cells: [[1, 1, 3], [1, 3, 6], [1, 6, 8], [2, 1, 3], [2, 3, 9]],
    paragraphs: [
      'Eu sou o Diel, engenheiro de software, e trabalho quase sempre com o que roda no navegador. Passo meus dias pensando em arquitetura e em experiência de desenvolvimento.',
      'Com o tempo, deixei de ser um full-stack generalista e me especializei em frontend. Gosto de interfaces com uma arquitetura fácil de entender: código dividido do jeito que o produto é organizado, interações modeladas como estado explícito e as partes invisíveis do sistema claras para quem chegar depois. Já liderei times, passei por empresas pequenas e grandes, e me viro bem em toda a stack, inclusive na infraestrutura.',
    ],
    projectsHeading: 'Projetos pessoais',
    photosHeading: 'Fotos',
    allPhotos: 'Todas as fotos',
    experienceHeading: 'Destaques da carreira',
    present: 'hoje',
    more: 'Mais no LinkedIn',
    newTab: '(abre em nova aba)',
  },
} satisfies Record<Lang, { cells: Array<[number, number, number]> } & Record<string, unknown>>;

const t = content[lang];

interface Job {
  company: string;
  /** The last title held there. */
  title: string;
  from: number;
  /** null while the job is current. */
  to: number | null;
}

// Newest first. Titles stay in English on both language versions, as on LinkedIn.
const experience: Job[] = [
  { company: 'Resend', title: 'Software Engineer', from: 2026, to: null },
  { company: 'Appcues', title: 'Principal Frontend Engineer', from: 2021, to: 2026 },
  { company: 'AvantStay', title: 'Senior Frontend Developer', from: 2019, to: 2021 },
  { company: 'GRITSpot', title: 'Senior Frontend Developer', from: 2018, to: 2018 },
  { company: 'Hotmart', title: 'Senior Frontend Developer', from: 2016, to: 2018 },
];

const sideProjects = [
  'https://feedrsauros.com/',
  'https://maestrio.ai/',
  'https://everythingsystemdesign.dev/',
  'https://socontratos.com/',
];
const domain = (url: string) => new URL(url).hostname;
const recentPhotos = (await photosNewestFirst()).slice(0, 4);

const years = ({ from, to }: Job) =>
  to === null ? `${from}–${t.present}` : from === to ? `${from}` : `${from}–${to}`;
---

<PageV2
  lang={lang}
  title={t.title}
  description={t.description}
  currentState="about"
  image={ogImagePath('about', lang)}
  langSwitchHref={t.langSwitchHref}
>
  <Spread
    lang={lang}
    sentence={t.sentence}
    cells={t.cells}
    highlight={4}
    portrait={{ rows: [1, 4], cols: [9, 13], variant: 'block' }}
    aside={{ text: t.country, cols: [1, 6] }}
  />

  <section class="frame">
    <div class="grid about">
      <div class="prose reading">
        {t.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="side-projects">
        <h2 class="section-heading">{t.projectsHeading}</h2>
        <ul class="projects">
          {sideProjects.map((url) => (
            <li>
              <a class="link" href={url} target="_blank" rel="noopener noreferrer">
                {domain(url)}<span class="sr-only"> {t.newTab}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="now-wrap">
        <h2 class="section-heading">{t.experienceHeading}</h2>
        <ol class="jobs">
          {experience.map((job) => (
            <li>
              <span class="years">{years(job)}</span>
              <span class="company">{job.company}</span>
              <span class="role">{job.title}</span>
            </li>
          ))}
        </ol>
        <a class="link more" href="https://www.linkedin.com/in/dielduarte/" target="_blank" rel="noopener noreferrer">
          {t.more}<span class="sr-only"> {t.newTab}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="frame">
    <div class="grid photos">
      <h2 class="section-heading">{t.photosHeading}</h2>
      <a class="link all-photos" href={photosIndexHref(lang)}>{t.allPhotos}</a>
      {recentPhotos.map((photo) => (
        <a class="shot" href={photoHref(lang, photo)}>
          <Image
            src={photo.data.image}
            alt={photo.data.alt[lang]}
            widths={[480, 800]}
            sizes="(max-width: 760px) 50vw, 25vw"
          />
        </a>
      ))}
    </div>
  </section>
</PageV2>

<style>
  .about {
    align-items: start;
  }

  .prose {
    grid-column: 1 / 6;
    grid-row: 1;
    padding: 12px var(--cell-pad) 0;
    max-width: 60ch;
  }

  .prose p {
    margin: 0 0 1em;
  }

  .side-projects {
    grid-column: 1 / 6;
    grid-row: 2;
    padding-bottom: 24px;
  }

  .projects {
    margin: 0;
    padding: 0 var(--cell-pad);
    list-style: none;
    font-size: var(--fs-small);
  }

  .projects li {
    padding: 2px 0;
  }

  .now-wrap {
    grid-column: 7 / 13;
    grid-row: 1 / 3;
    display: grid;
    grid-template-columns: subgrid;
  }

  .section-heading {
    grid-column: 1 / -1;
    margin: 0;
    padding: 12px var(--cell-pad) 10px;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--muted);
  }

  .jobs {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jobs li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding: 9px 0;
    border-top: 1px solid var(--rule);
  }

  .jobs li > span {
    padding: 0 var(--cell-pad);
  }

  .years {
    grid-column: 1 / 2;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .company {
    grid-column: 2 / 4;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .role {
    grid-column: 4 / -1;
    font-size: var(--fs-small);
  }

  .more {
    grid-column: 1 / -1;
    justify-self: start;
    margin: 14px var(--cell-pad) 0;
    font-size: var(--fs-small);
  }

  .photos {
    align-items: end;
    padding-bottom: 32px;
  }

  .photos .section-heading {
    grid-column: 1 / 10;
  }

  .all-photos {
    grid-column: 10 / 13;
    padding: 12px var(--cell-pad) 10px;
    font-size: var(--fs-small);
  }

  .shot {
    grid-column: span 3;
    padding: var(--cell-pad);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .prose,
    .side-projects,
    .now-wrap { grid-column: 1 / -1; grid-row: auto; }

    .photos .section-heading { grid-column: 1 / 3; }
    .all-photos { grid-column: 3 / -1; text-align: right; }
    .shot { grid-column: span 2; }

    .years { grid-column: 1 / 2; }
    .company { grid-column: 2 / 3; }
    .role { grid-column: 3 / -1; }
  }
</style>
