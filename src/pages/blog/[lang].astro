---
import PageV2 from '../../layouts/PageV2.astro';
import { ogImagePath } from '../../lib/og-pages.mjs';
import Spread from '../../components/grid/Spread.astro';
import PostRow from '../../components/grid/PostRow.astro';
import { postsFor } from '../../lib/writing';
import type { Lang } from '../../components/nav/navMachine';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt-br' } }];
}

const { lang } = Astro.params as { lang: Lang };

const content = {
  en: {
    title: 'Writing — Diel Duarte',
    description:
      'Essays on architecture, developer experience, and the details that keep software readable as it grows.',
    langSwitchHref: '/blog/pt-br/',
    sentence: 'I write about web software',
    cells: [[1, 1, 2], [1, 2, 5], [1, 6, 9], [2, 2, 5], [2, 6, 11]],
    heading: 'Writing',
    count: (n: number, from: string, to: string) => `${n} entries, ${from}–${to}`,
  },
  'pt-br': {
    title: 'Textos — Diel Duarte',
    description:
      'Textos sobre arquitetura, experiência de desenvolvimento e os detalhes que mantêm um software fácil de entender conforme ele cresce.',
    langSwitchHref: '/blog/en/',
    sentence: 'Eu escrevo sobre software para a web',
    cells: [[1, 1, 3], [1, 3, 7], [1, 8, 11], [2, 2, 6], [2, 7, 9], [2, 9, 10], [3, 4, 7]],
    heading: 'Textos',
    count: (n: number, from: string, to: string) => `${n} textos, ${from}–${to}`,
  },
} satisfies Record<Lang, { cells: Array<[number, number, number]> } & Record<string, unknown>>;

const t = content[lang];
const posts = postsFor(lang);
const years = posts.map((p) => p.date.slice(0, 4));
---

<PageV2
  lang={lang}
  title={t.title}
  description={t.description}
  currentState="writing"
  image={ogImagePath('writing', lang)}
  langSwitchHref={t.langSwitchHref}
>
  <Spread
    lang={lang}
    sentence={t.sentence}
    cells={t.cells}
    highlight={1}
    portrait={{ rows: [1, 3], cols: [12, 13], variant: 'strip' }}
  />

  <section class="frame" aria-labelledby="writing-heading">
    <div class="grid">
      <h2 id="writing-heading" class="section-title">{t.heading}</h2>
      <p class="section-meta">{t.count(posts.length, years.at(-1) ?? '', years[0] ?? '')}</p>
      <div class="list">
        {posts.map((post, i) => (
          <PostRow post={post} variant="full" showYear={years[i] !== years[i - 1]} />
        ))}
      </div>
    </div>
  </section>

</PageV2>

<style>
  .list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }
</style>
