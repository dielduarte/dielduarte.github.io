---
import PageV2 from '../../layouts/PageV2.astro';
import Spread from '../../components/grid/Spread.astro';
import type { Lang } from '../../components/nav/navMachine';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt-br' } }];
}

const { lang } = Astro.params as { lang: Lang };

const content = {
  en: {
    title: 'Contact — Diel Duarte',
    description: 'Get in touch with Diel Duarte: email, GitHub, LinkedIn, Twitter.',
    langSwitchHref: '/contact/pt-br/',
    sentence: 'Email me about anything',
    cells: [[1, 1, 5], [1, 6, 8], [2, 2, 6], [2, 7, 11]],
    highlight: 0,
    lede: 'Send me an email. I read everything and reply when I have something worth saying. For quick stuff, Twitter DMs are open.',
    channelsHeading: 'Channels',
    footnote: 'Happy to chat.',
    newTab: '(opens in new tab)',
  },
  'pt-br': {
    title: 'Contato — Diel Duarte',
    description: 'Fale com o Diel Duarte por e-mail, GitHub, LinkedIn ou Twitter.',
    langSwitchHref: '/contact/en/',
    sentence: 'Me escreva sobre qualquer coisa',
    cells: [[1, 1, 3], [1, 4, 9], [2, 1, 5], [2, 6, 10], [3, 3, 6]],
    highlight: 1,
    lede: 'Me envie um e-mail. Leio tudo e respondo quando tenho algo que valha a pena dizer. Para coisas rápidas, pode me chamar na DM do Twitter.',
    channelsHeading: 'Canais',
    footnote: 'Será um prazer conversar.',
    newTab: '(abre em nova aba)',
  },
} satisfies Record<Lang, { cells: Array<[number, number, number]> } & Record<string, unknown>>;

const t = content[lang];

const channels = [
  { label: 'Email', handle: 'magdiel.kesller@gmail.com', href: 'mailto:magdiel.kesller@gmail.com' },
  { label: 'GitHub', handle: 'dielduarte', href: 'https://github.com/dielduarte' },
  { label: 'LinkedIn', handle: 'in/dielduarte', href: 'https://www.linkedin.com/in/dielduarte/' },
  { label: 'Twitter', handle: '@diel_duarte', href: 'https://twitter.com/diel_duarte' },
];
---

<PageV2
  lang={lang}
  title={t.title}
  description={t.description}
  currentState="contact"
  langSwitchHref={t.langSwitchHref}
>
  <Spread
    lang={lang}
    sentence={t.sentence}
    cells={t.cells}
    highlight={t.highlight}
    portrait={{ rows: [1, 3], cols: [12, 13], variant: 'strip' }}
  />

  <section class="frame">
    <div class="grid contact">
      <p class="lede reading">{t.lede}</p>
      <h2 class="sr-only">{t.channelsHeading}</h2>
      <ul class="channels">
        {channels.map((c) => {
          const external = !c.href.startsWith('mailto:');
          return (
            <li>
              <a
                href={c.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <span class="label">{c.label}</span>
                <span class="handle">{c.handle}</span>
                {external && <span class="sr-only">{t.newTab}</span>}
              </a>
            </li>
          );
        })}
      </ul>
      <p class="footnote">{t.footnote}</p>
    </div>
  </section>
</PageV2>

<style>
  .contact {
    align-items: start;
  }

  .lede {
    grid-column: 1 / 5;
    margin: 0;
    padding: 12px var(--cell-pad) 24px;
  }

  .channels {
    grid-column: 5 / 13;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li {
    display: contents;
  }

  .channels a {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (hover: hover) and (pointer: fine) {
    .channels a:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }

  .label {
    grid-column: 1 / 3;
    padding: 0 var(--cell-pad);
    color: var(--muted);
    align-self: center;
  }

  .channels a:hover .label { color: inherit; opacity: 0.7; }

  .handle {
    grid-column: 3 / -1;
    padding: 0 var(--cell-pad);
    font-size: clamp(17px, 1.9vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .footnote {
    grid-column: 5 / 11;
    margin: 0;
    padding: 16px var(--cell-pad);
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .lede,
    .channels,
    .footnote { grid-column: 1 / -1; }

    .label { grid-column: 1 / 2; }
    .handle { grid-column: 2 / -1; }
  }
</style>
